<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>11.2.0</Version>
		<NoWarn>$(NoWarn);NETSDK1206</NoWarn>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\out</OutputPath>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\out</OutputPath>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="log4net" Version="3.6.0" />
		<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Polly" Version="8.9.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIT.Common\SIT.Common.csproj" />
    <ProjectReference Include="..\SW360KeycloakService\SW360KeycloakService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
