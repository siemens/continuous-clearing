<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	<add key="energy-dev-nuget-egll" value="https://siemens.jfrog.io/artifactory/api/nuget/energy-dev-nuget-egll" />
  </packageSources>
  <packageSourceMapping>
	<packageSource key="nuget.org">
	  <package pattern="*" />
	</packageSource>
	<packageSource key="energy-dev-nuget-egll">
	  <package pattern="Telemetry.*" />
	</packageSource>
  </packageSourceMapping>
</configuration>
