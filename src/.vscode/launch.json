    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SIT.Scan",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-scan",
            "program": "${workspaceFolder}/../out/net10.0/SIT.Scan.dll",
            "args": [
                "--settingsfilepath",
                "D:\\NewConfigfile\\AppSettings.json"
            ],
            "cwd": "${workspaceFolder}/../out/net10.0",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Debug SIT.Create",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/../out/net10.0/SIT.Create.dll",
            "args": [
                "--settingsfilepath",
                "D:\\NewConfigfile\\AppSettings.json"
            ],
            "cwd": "${workspaceFolder}/../out/net10.0",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}